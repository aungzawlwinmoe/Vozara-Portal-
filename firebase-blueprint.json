{
  "entities": {
    "User": {
      "title": "User",
      "description": "User account representation",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "email": { "type": "string" },
        "name": { "type": "string" },
        "role": { "type": "string" },
        "status": { "type": "string" },
        "createdAt": { "type": "string" }
      },
      "required": ["id", "email", "name", "role", "status", "createdAt"]
    },
    "Submission": {
      "title": "Submission",
      "description": "A checklist item document submission",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "itemId": { "type": "string" },
        "userId": { "type": "string" },
        "fileName": { "type": "string" },
        "fileSize": { "type": "string" },
        "status": { "type": "string" },
        "submittedAt": { "type": "string" }
      },
      "required": ["id", "itemId", "userId", "fileName", "fileSize", "status"]
    },
    "AuditLog": {
      "title": "AuditLog",
      "description": "System action trace message",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "userId": { "type": "string" },
        "userName": { "type": "string" },
        "userRole": { "type": "string" },
        "action": { "type": "string" },
        "details": { "type": "string" },
        "timestamp": { "type": "string" }
      },
      "required": ["id", "userId", "userName", "userRole", "action", "details", "timestamp"]
    },
    "ChatMessage": {
      "title": "ChatMessage",
      "description": "Message in interactive companion chat",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "userId": { "type": "string" },
        "role": { "type": "string" },
        "content": { "type": "string" },
        "timestamp": { "type": "string" }
      },
      "required": ["id", "userId", "role", "content", "timestamp"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": "User",
      "description": "Collection of user records"
    },
    "/submissions/{submissionId}": {
      "schema": "Submission",
      "description": "Collection of submitted compliance documents"
    },
    "/auditLogs/{auditLogId}": {
      "schema": "AuditLog",
      "description": "Collection of security audit logs"
    },
    "/chatMessages/{messageId}": {
      "schema": "ChatMessage",
      "description": "Collection of micro-conversation snippets for the Gemini chatbot interface"
    }
  }
}
